# Production settings. Copy to ".env" on the server and fill in real values.
#   cp .env.example .env && chmod 600 .env

SITE_ADDRESS=todo.lazuar.dev

POSTGRES_USER=todo
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=todo

# Which image version to run. "latest" follows every push to main.
# Set a commit SHA here to pin (and to roll back).
TAG=latest

# Only when ANOTHER reverse proxy (for example a shared Caddy) already owns
# ports 80 and 443 on this server. This makes every `docker compose` command in
# this folder use the shared-gateway variant. See docs/10-shared-server.md.
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-gateway.yml
